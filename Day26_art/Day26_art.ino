// define with extern, so compiler doesn't complain AND we are not putting 
// a lot of code on top
extern const unsigned char epd_bitmap_cat1[] U8X8_PROGMEM;
extern const unsigned char epd_bitmap_cat2[] U8X8_PROGMEM;
extern const unsigned char epd_bitmap_cat3[] U8X8_PROGMEM;
extern const unsigned char epd_bitmap_cat4[] U8X8_PROGMEM;
extern const unsigned char epd_bitmap_cat5[] U8X8_PROGMEM;
extern const unsigned char epd_bitmap_cat6[] U8X8_PROGMEM;
extern const unsigned char epd_bitmap_cat7[] U8X8_PROGMEM;
